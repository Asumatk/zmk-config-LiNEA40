#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// レイヤー番号（roBa / Keyball39 と共通）
#define FUNCTION 1
#define NUM 2
#define ARROW 3
#define MOUSE 4
#define SCROLL 5
#define SYS 6

//mouse cursol

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    // roBa / Keyball39 と同じ同時押し（D+F=英数, J+K=かな, L+'=", F+G=Win+Shift+S, H+J=-, V+B=:, N+M=;）
    combos {
        compatible = "zmk,combos";

        eisu {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        kana {
            bindings = <&kp LANG1>;
            key-positions = <16 17>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <18 19>;
        };

        snip {
            bindings = <&kp LS(LG(S))>;
            key-positions = <13 14>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <15 16>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <23 24>;
        };

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <25 26>;
        };
    };

    // Space長押し(NUM) と Enter長押し(FUNCTION) を同時に押している間は ARROW
    conditional_layers {
        compatible = "zmk,conditional-layers";

        arrow_cond {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // 1回タップ=英数 / 2回タップ=かな
        td_ime: tap_dance_ime {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_IME";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LANG2>, <&kp LANG1>;
        };

        // 長押し=SYSレイヤー / タップ=レイヤー0に戻って「変換」
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &lt 5 I  &kp O  &kp P
&kp A  &mt LEFT_WIN S  &mt LEFT_ALT D  &mt LEFT_SHIFT F  &kp G  &kp H  &mt RIGHT_SHIFT J  &mt RIGHT_ALT K  &mt LWIN L  &kp SQT
&mt LEFT_SHIFT Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH
&gresc  &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 INT_HENKAN  &lt 2 SPACE  &mt LEFT_CONTROL TAB  &kp BACKSPACE  &lt 1 ENTER  &kp MINUS  &kp SEMICOLON  &td_ime
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        function_layer {
            display-name = "FUNCTION";
            bindings = <
&kp MINUS  &kp NUMBER_7  &kp N8  &kp NUMBER_9  &kp LS(N5)  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&kp SLASH  &mt LEFT_WIN NUMBER_4  &mt LEFT_ALT NUMBER_5  &mt LSHFT NUMBER_6  &kp ASTERISK  &kp F7  &kp F8  &kp UP_ARROW  &kp F9  &kp F10
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS  &kp F6  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &kp F11
&kp DELETE  &kp N0  &trans  &kp PERIOD  &lt 2 EQUAL  &trans  &trans  &trans  &trans  &trans  &kp F12
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&kp MINUS  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(KP_NUMBER_5)  &kp EQUAL  &kp LS(N6)  &kp LS(EQUAL)  &kp LS(N8)  &kp LS(N9)
&kp SLASH  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp LS(SQT)  &kp EXCLAMATION  &kp LEFT_BRACKET  &kp HASH  &kp DOLLAR  &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp LS(SEMI)  &kp RIGHT_BRACKET  &kp NON_US_HASH  &kp LS(RIGHT_BRACKET)  &kp LS(NON_US_HASH)  &kp INT3
&kp LS(LEFT_BRACKET)  &kp LS(MINUS)  &kp LS(INT1)  &kp PERIOD  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(INT3)
            >;
        };

        arrow_layer {
            display-name = "ARROW";
            bindings = <
&kp ESCAPE  &kp LC(LS(TAB))  &kp UP_ARROW  &kp LC(TAB)  &trans  &trans  &trans  &trans  &trans  &trans
&kp HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END  &trans  &kp LEFT_BRACKET  &kp QUESTION  &kp LS(INT1)  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans  &kp LG(LS(RIGHT_ARROW))  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mo 5  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        scroll_layer {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        sys_layer {
            display-name = "SYS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &bootloader  &trans  &trans  &trans  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock  &trans  &trans  &bt BT_CLR_ALL
            >;
        };
    };
};
